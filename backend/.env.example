# EvidenceOCR Backend Configuration Template
# Copy this file to .env and supply environment-specific credentials.

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# MongoDB Atlas Configuration
# PyMongo Async connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=evidence_ocr
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Security & CORS
# JSON-encoded array of allowed origins for browser clients
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001"]

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Ingestion Constraints (aligned with frontend contract)
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGES=20
UPLOAD_TIMEOUT_SECONDS=30
ALLOWED_MIME_TYPES=["image/png", "image/jpeg", "image/webp", "application/pdf"]
GRIDFS_BUCKET_NAME=evidence_files

# Official PaddleOCR Cloud API
PADDLEOCR_ACCESS_TOKEN=<your_aistudio_access_token>
PADDLEOCR_MODEL=PP-OCRv6
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_REQUEST_TIMEOUT_SECONDS=60
PADDLEOCR_POLL_TIMEOUT_SECONDS=300
PADDLEOCR_MAX_CONCURRENT_JOBS=2

# PaddleOCR-VL Document Intelligence
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_VL_ENABLED=true
PADDLEOCR_VL_REQUEST_TIMEOUT_SECONDS=60
PADDLEOCR_VL_POLL_TIMEOUT_SECONDS=300
PADDLEOCR_VL_MAX_CONCURRENT_JOBS=1

# Evidence Fusion & Bounded Recovery
FUSION_STRATEGY=evidence_aware
FUSION_MAX_TROCR_VARIANTS=2
FUSION_RECOVERY_BUDGET_SECONDS=120
FUSION_MAX_CLOUD_ESCALATIONS=0
FUSION_ALIGNMENT_W1=0.5
FUSION_ALIGNMENT_W2=0.3
FUSION_ALIGNMENT_W3=0.1
FUSION_ALIGNMENT_W4=0.1
