# EvidenceOCR Backend Configuration Template
# Copy this file to .env and supply environment-specific credentials.

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# MongoDB Atlas Configuration
# PyMongo Async connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=evidence_ocr
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000

# Security & CORS
# JSON-encoded array of allowed origins for browser clients
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Ingestion Constraints (aligned with frontend contract)
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_MIME_TYPES=["image/png", "image/jpeg", "image/webp", "application/pdf"]
